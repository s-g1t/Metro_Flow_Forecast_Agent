# Copy to .env and fill in. .env is gitignored — never commit real keys.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-2.0-flash
# Where the forecast repo lives on your machine (the tools git-pull it before every run).
# Defaults to ~/RStudio/Projects/Market_Office_Flow_Forecast if left unset.
FORECAST_REPO_DIR=
